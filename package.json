    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.5.7",
    "@types/oauth": "^0.9.6",
    "@types/prismjs": "^1.26.5",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
